      "minecraft:short_grass",
      "minecraft:fern",
      "minecraft:dandelion",
      "minecraft:poppy",
      "minecraft:azure_bluet",
      "minecraft:oxeye_daisy",
      "minecraft:cornflower",
      "minecraft:leaf_litter",
      "minecraft:dead_bush",
      "minecraft:snow_layer"
    ],
    "may_attach_to": {
      "bottom": [
        "minecraft:stone",
        "minecraft:andesite",
        "minecraft:diorite",
        "minecraft:granite"
      ]
    }
  }
}